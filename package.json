{
  "name": "backend",
  "version": "1.0.2",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.test.json",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "start:local": "ts-node --transpile-only src/index.ts",
    "up": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-recollect.ps1",
    "autostart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-autostart.ps1",
    "build": "tsc",
    "db:start": "node scripts/dev-db.mjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "db:dump": "node scripts/db-dump.mjs",
    "search:reindex": "ts-node --transpile-only scripts/search-reindex.ts",
    "postinstall": "prisma generate"
  },
