// Recollect: PostgreSQL schema (Prisma 7, same setup as Revise: prisma-client-js + @prisma/adapter-pg).
//
// It mirrors the 13 kept Mongoose models (deleted after the port; see git history) field for field: defaults, enums, indexes.
// Read backend/docs/MIGRATION_CONVENTIONS.md before porting a module.
//
// Conventions
// - Ids are cuid strings. The REST API still calls them `_id` (see src/db/serializers).
// - Embedded arrays that are queried became child/join tables (DocCollaborator,
//   WorkspaceMember, Space, TodoAssignee, TodoTag). Embedded data that is never queried became Json.
// - Mongoose `timestamps: true` became createdAt/updatedAt.
// - Mongo had no foreign keys. Here, rows owned by a user/doc/workspace/todo CASCADE when the parent
//   is deleted; optional references (sender, targetUser, targetTask, space on a todo) SET NULL.
// - Defaults Prisma cannot express (share-link expiry, invite tokens, reminderEmail = email,
//   todo completedAt, trimming, lowercasing, bcrypt) are done in code; see src/db/defaults.ts.
// - Cut features (content, dashboards, expenses, email, slides, livekit) are not modelled. The
//   whiteboard was cut later: its tables are dropped by the drop_whiteboard migration (code and
//   schema in backend/_archive/drawing).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// Users & auth
// ============================================================================

enum UserStatus {
  active
  pending
}

enum AuthProvider {
  local
  google
}

model User {
  id            String       @id @default(cuid())
  /// Trimmed; at most 50 characters (Mongoose maxLength).
  name          String       @db.VarChar(50)
  /// Unique and trimmed. NOT lowercased by the model (only some flows lowercase it), as in Mongo.
  email         String       @unique
  /// Defaults to `email` on create (old Mongoose pre-save hook): the users service does it.
  reminderEmail String?      @unique
  phone         String       @default("")
  /// bcrypt hash. Omitted from every query by default: see the global `omit` in src/db/prisma.ts.
  password      String?
  avatar        String       @default("")
  cloudPublicId String       @default("")
  cloudProvider String       @default("")
  status        UserStatus   @default(active)
  /// Placeholder user created when someone is invited/assigned by email before signing up.
  isGhost       Boolean      @default(false)
  googleId      String       @default("")
  authProvider  AuthProvider @default(local)
  /// Stage 10 (ECOSYSTEM_V2_PLAN §9.5): free | premium. The seam only: nothing reads it yet, no payment code.
  plan          String       @default("free") @db.VarChar(12)
  /// Stage 11 (the People page): the owner ended this account's access. Sign-in and every request are refused, the
  /// account and its data are kept, and the owner can restore it. Null: open.
  accessEndedAt DateTime?
  /// Stage 11 (§9.6 item 2): Home's first-run checklist for a new account: { zoneOk?: true, dismissedAt?: ISO }.
  /// Null: nothing done yet. Only accounts made in the last 30 days see it.
  firstRun      Json?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  docs                 Doc[]
  docCollaborations    DocCollaborator[]
  accessRequests       AccessRequest[]
  todos                Todo[]
  todoAssignments      TodoAssignee[]
  ownedWorkspaces      Workspace[]
  workspaceMemberships WorkspaceMember[]
  inviteLinksCreated   WorkspaceInviteLink[]
  activities           ActivityLog[]         @relation("ActivityActor")
  activitiesAsTarget   ActivityLog[]         @relation("ActivityTargetUser")
  notifications        Notification[]        @relation("NotificationRecipient")
  notificationsSent    Notification[]        @relation("NotificationSender")
  recentVisits         RecentVisit[]
  reminders            Reminder[]

  // ── Learning (Revise's dashboard; see the Learning section at the end) ──
  /// IANA zone for learning days ("today", streaks, slots, goal due days).
  timezone                 String      @default("Asia/Kolkata")
  /// Revise Workspace.routineMode.
  routineMode              RoutineMode @default(MASTER)
  /// Global revision streak = engine StreakState. lastGlobalStreakDay = last credited day,
  /// or the last rest day bridged by the rollover.
  globalStreak             Int         @default(0)
  longestGlobalStreak      Int         @default(0)
  lastGlobalStreakDay      DateTime?   @db.Date
  /// StreakSnapshot { current, longest, lastCreditDay } from just before the last credit (same-day undo).
  globalStreakBeforeCredit Json?
  /// Last local day the rollover finished for this user (null = never).
  learningRolledOverDay    DateTime?   @db.Date

  // ── Daily loop v2 settings (LOOP_V2_SPEC §1) ──
  /// The size of Today in minutes (5–120).
  dailyBudgetMin           Int        @default(25)
  /// 11-22 (the owner): their public LeetCode username; once a day their newly accepted problems are logged as practice.
  leetcodeUser             String?    @db.VarChar(40)
  /// When the LeetCode import last ran for them.
  leetcodeSyncedAt         DateTime?
  /// PERSONAL_OFFICE_PLAN (11-23): work counts as progress too (active days, hours, the buddy). Off: personal only.
  progressIncludesWork     Boolean    @default(false)
  /// STUDY_FLOW_PLAN §4.5 (11-23): building their own projects counts as progress too (learning always does). On by
  /// default: it did before the choice existed.
  progressIncludesBuilding Boolean    @default(true)
  /// EASY_SETUP_PLAN (11-23): what a folder the server has never seen is (Settings › Tracking): ask (the agent asks
  /// them once), a kind, or off (not logged).
  newFolders               NewFolders @default(ask)
  /// TOOL_ACCESS_PLAN §4.7 (11-27): chats may read, change and delete their pocket notes (Settings › Agents). Off by
  /// default: agents add pocket notes, never read them, until the person allows it.
  pocketForAgents          Boolean    @default(false)
  /// Time blocks / timeline / Day Manager / triage / debrief / catch-up. Off: GET /api/today
  /// returns schedule/triage/todayDebrief null and the rollover creates no slots.
  routineEnabled           Boolean    @default(false)
  /// Busy mode is on while today <= busyUntil (a local day).
  busyUntil                DateTime?  @db.Date
  nudgeEmailEnabled        Boolean    @default(true)
  /// 'HH:mm', the user's local time for the morning email.
  nudgeTime                String     @default("08:30")
  /// "About me, for my agents" (SYNC_SPINE_SPEC 1.3): how the user learns and works, read first by every chat's brief.
  agentProfile             String?    @db.VarChar(600)
  /// Local day the morning email was last sent (idempotency).
  lastNudgeDay             DateTime?  @db.Date
  /// Local day the morning notification was last sent (idempotency; ALWAYS_ON_SPEC 6.3).
  lastPushDay              DateTime?  @db.Date
  /// Local day of the last POST /api/learning/ensure-today (the app was opened).
  lastSeenDay              DateTime?  @db.Date
  /// lastSeenDay as it was before today's first visit, so "comeback" mode lasts the whole day
  /// after ensure-today moved lastSeenDay to today.
  prevSeenDay              DateTime?  @db.Date

  subjects       Subject[]
  topics         Topic[]
  captures       Capture[]
  revisions      Revision[]
  subjectStreaks SubjectStreak[]
  dailyHistory   DailyHistory[]
  timeBlocks     TimeBlock[]
  scheduleSlots  DailyScheduleSlot[]
  dayDebriefs    DayDebrief[]
  quickNotes     QuickNote[]
  focusItems     FocusItem[]
  goals          Goal[]

  // ── Agents (personal access tokens, the agent edit log; see the Agents section at the end) ──
  apiTokens       ApiToken[]
  oauthCodes      OAuthCode[]
  deviceSignIns   DeviceSignIn[]
  agentEdits      AgentEdit[]
  idempotencyKeys IdempotencyKey[]

  // ── AI (Recall mode, the spend meter, the weekly coach; see the AI section at the end) ──
  recallSets RecallSet[]
  aiUsage    AiUsage[]
  aiSettings AiSettings?
  coachNotes CoachNote[]

  // ── The record (SYNC_SPINE_SPEC 1.2: sessions, projects, weak spots; see the end) ──
  workSessions WorkSession[]
  projects     Project[]
  weakSpots    WeakSpot[]
  weekTargets  WeekTarget[]
  suggestions  Suggestion[]
  decisions    Decision[]

  // ── Imports (the Revise import; see the end) ──
  importedRows ImportedRow[]

  // ── The Ask AI manager's conversations (see the end) ──
  assistantThreads AssistantThread[]

  // ── The morning notification (Web Push; see the end) ──
  pushSubscriptions PushSubscription[]

  // ── The buddy (context/specs/BUDDY_MEMORY_PLAN.md; see the end) ──
  buddyState        BuddyState?
  observations      Observation[]
  memories          Memory[]
  buddyChunks       BuddyChunk[]
  buddyThreads      BuddyThread[]
  buddyAsks         BuddyAsk[]
  lockPins          LockPin[]
  buddyReminders    BuddyReminder[]
  buddyOutcomes     BuddyOutcome[]
  standTakes        StandTake[]
  subjectDeletions  SubjectDeletion[]
  buddyImports      BuddyImport[]
  buddyCatchUps     BuddyCatchUp[]
  buddyScreenRules  BuddyScreenRule[]
  aiKeys            AiKey[]
  // Stage 11 (the People page): the free AI the owner gives, the invites, what people send.
  aiGrants          AiGrant[]          @relation("AiGrantTo")
  aiGrantsGiven     AiGrant[]          @relation("AiGrantBy")
  invitesSent       SignupInvite[]     @relation("InviteBy")
  invitesUsed       SignupInvite[]     @relation("InviteUsedBy")
  feedback          Feedback[]
  // TRUST_PLAN T4 (11-27): what the app showed the owner of this person, and what the owner did to their account.
  ownerAccess       OwnerAccess[]
  buddyHeard        BuddyHeard[]
  buddySessionMarks BuddySessionMark[]
  buddyDays         BuddyCaptureDay[]
  buddySteps        BuddyDay[]
  buddyThumbs       BuddyFeedback[]
  routines          Routine[]
  chapters          BuddyChapter[]
  workLines         WorkLine[]

  @@index([googleId])
}

enum OtpPurpose {
  signup
  password_reset @map("password-reset")
}

model Otp {
  id         String     @id @default(cuid())
  /// Stored lowercased.
  email      String
  /// 6 digits (4 before the hosting review, 11-16).
  otp        String
  /// Signup only: { name, passwordHash }. The password is hashed before it is stored.
  signupData Json?
  purpose    OtpPurpose @default(signup)
  /// An OTP is valid for 180 s after createdAt. Mongo deleted it with a TTL index; here the
  /// OTP service checks the age explicitly and a cron deletes expired rows.
  createdAt  DateTime   @default(now())
  /// Wrong codes tried against it; the code is deleted at the 5th (hosting P1-4).
  wrongTries Int        @default(0)

  @@index([email])
  @@index([createdAt])
}

// ============================================================================
// Docs, collaboration, sharing
// ============================================================================

enum CollaboratorRole {
  editor
  viewer
}

model Doc {
  id           String                   @id @default(cuid())
  userId       String
  user         User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Trimmed.
  title        String
  /// The doc's Yjs state (an encoded update), as bytes (D3, 2026-11-15; Base64 text before).
  yjsState     Bytes?
  previewState String?
  coverImage   String?
  isPinned     Boolean                  @default(false)
  isArchived   Boolean                  @default(false)
  /// [{ imageId, cloudUrl, cloudPublicId }]
  cloudImages  Json                     @default("[]")
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  /// In the trash since then (MANAGER_AND_DOCS_PLAN §3.2): hidden from lists and search, deleted for
  /// good 30 days later (or when the trash is emptied). Restoring clears it.
  trashedAt    DateTime?
  /// Published to the web (MANAGER_AND_DOCS_PLAN §2): anyone with /p/<publicSlug> can read it, no login,
  /// never edit. Stable until unpublished (both cleared); publishing again makes a new slug.
  publicSlug   String?                  @unique
  publishedAt  DateTime?
  /// STUDY_FLOW_PLAN §4.4 (11-23): the heading block that starts the doc's revision card (its last section, written
  /// by set_revision_card); a review shows the card first. Null = no card; a deleted heading = no card either.
  cardBlockId  String?
  /// The doc's words for search (each block on its line, canvas boards' words too). NULL = not
  /// written yet: a content change that doesn't bring them sets NULL (trigger, migration
  /// 20261114250000_doc_search) and src/services/docs/docSearch.service.ts writes them. Omitted
  /// from every query by default (src/db/prisma.ts).
  searchText   String?
  /// Kept by a trigger from title (weight A) and searchText (B), English stems and plain words; GIN index.
  /// Raw SQL only (docSearch.service.ts).
  searchVector Unsupported("tsvector")?

  collaborators    DocCollaborator[]
  accessRequests   AccessRequest[]
  /// Learning topics whose content is this doc (at most one per user).
  topics           Topic[]
  /// States taken before agent edits (Undo), and the agent edit log.
  snapshots        DocSnapshot[]
  agentEdits       AgentEdit[]
  /// Recall question sets written from this doc.
  recallSets       RecallSet[]
  /// Ask AI asked from inside this doc (DOCS_EDITOR_V2_PLAN phase 5).
  assistantThreads AssistantThread[]
  /// DOC_PAGES_PLAN (11-27): the doc this page is inside (null = top level). SET NULL: deleting a parent for good
  /// never deletes a child by cascade.
  parentId         String?
  parent           Doc?              @relation("DocPages", fields: [parentId], references: [id], onDelete: SetNull)
  pages            Doc[]             @relation("DocPages")
  /// Order among the pages of one parent, ascending (unused at the top level).
  position         Float             @default(0)
  /// In the trash because this doc's ancestor was trashed: restoring that one brings this back. Null = trashed itself.
  trashedWithId    String?
  /// DOC_PAGES_PLAN D4: the notes written on this page (each keeps its lesson's topic).
  pageNotes        Capture[]

  @@index([userId])
  @@index([userId, updatedAt(sort: Desc)])
  @@index([searchVector], type: Gin)
  @@index([trashedAt])
  @@index([parentId, position])
}

/// Doc.collaborators[] in Mongo (queried as 'collaborators.user' 23 times).
model DocCollaborator {
  id      String           @id @default(cuid())
  docId   String
  doc     Doc              @relation(fields: [docId], references: [id], onDelete: Cascade)
  userId  String
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    CollaboratorRole @default(editor)
  addedAt DateTime         @default(now())

  @@unique([docId, userId])
  @@index([userId])
}

enum AccessRequestStatus {
  pending
  approved
  rejected
}

/// A visitor of a published doc asks the owner to edit it (one per person and doc; asking again reopens it).
model AccessRequest {
  id          String              @id @default(cuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  docId       String
  doc         Doc                 @relation(fields: [docId], references: [id], onDelete: Cascade)
  status      AccessRequestStatus @default(pending)
  /// What they asked for: a visitor of a published doc asks to edit.
  role        CollaboratorRole    @default(editor)
  requestedAt DateTime            @default(now())
  respondedAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([userId, docId])
  @@index([docId, status])
}

// ============================================================================
// Tags & todos
// ============================================================================

/// Global task labels (no owner), as in Mongo ('Tags').
model Tag {
  id        String   @id @default(cuid())
  /// Unique and trimmed.
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  todos TodoTag[]
}

enum TodoStatus {
  pending
  in_progress
  review
  blocked
  complete
}

enum TodoPriority {
  low
  normal
  medium
  high
  urgent
}

enum TodoVisibility {
  private
  shared
  workspace
}

model Todo {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Trimmed.
  title        String
  /// Rich text (TipTap JSON serialized to a string), as in Mongo.
  description  String?
  status       TodoStatus     @default(pending)
  priority     TodoPriority   @default(low)
  dueDate      DateTime?
  reminderDate DateTime?
  /// Set when status becomes 'complete' (old Mongoose pre-save hook): the todos service does it.
  completedAt  DateTime?
  /// [{ id, text, isCompleted }]
  subtasks     Json           @default("[]")
  /// [{ imageId, cloudPublicId }]
  cloudImages  Json           @default("[]")
  /// { pattern: 'daily' | 'weekly' | 'monthly', interval } or null.
  recurrence   Json?
  assignedAt   DateTime?
  visibility   TodoVisibility @default(private)
  workspaceId  String?
  workspace    Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// One of the workspace's spaces (Workspace.spaces[]._id in Mongo).
  spaceId      String?
  space        Space?         @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  /// [{ type: 'doc' | 'content' | 'slide', refId, title }]. Queried with
  /// `array_contains` (Mongo $elemMatch); the GIN index serves that.
  references   Json           @default("[]")
  /// Revise weekly/monthly goals (Home "Weekly" tab, Monday review).
  goalType     GoalType       @default(NONE)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  assignees   TodoAssignee[]
  tags        TodoTag[]
  weekTargets WeekTarget[]
  reminders   Reminder[]
  activities  ActivityLog[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, status])
  @@index([userId, priority])
  @@index([userId, dueDate])
  @@index([references(ops: JsonbPathOps)], type: Gin)
  @@index([workspaceId, visibility])
  @@index([workspaceId, visibility, status])
  @@index([workspaceId, spaceId])
}

/// Todo.assignees[] in Mongo. Order rows by createdAt to get the old array order.
model TodoAssignee {
  todoId    String
  todo      Todo     @relation(fields: [todoId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([todoId, userId])
  @@index([userId])
}

/// Todo.tags[] in Mongo. Order rows by createdAt to get the old array order.
model TodoTag {
  todoId    String
  todo      Todo     @relation(fields: [todoId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([todoId, tagId])
  @@index([tagId])
}

// ============================================================================
// Workspaces
// ============================================================================

enum WorkspaceRole {
  admin
  member
  viewer
}

model Workspace {
  id        String   @id @default(cuid())
  /// Trimmed; at most 100 characters (Mongoose maxlength).
  name      String   @db.VarChar(100)
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  /// { membersCanViewOverview: boolean }
  settings  Json     @default("{\"membersCanViewOverview\":false}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members     WorkspaceMember[]
  spaces      Space[]
  todos       Todo[]
  inviteLinks WorkspaceInviteLink[]
  activities  ActivityLog[]

  @@index([ownerId])
}

/// Workspace.members[] in Mongo (queried as 'members.user' 10 times). The owner is not
/// necessarily a member row, exactly as in Mongo.
model WorkspaceMember {
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        WorkspaceRole @default(member)
  joinedAt    DateTime      @default(now())

  @@id([workspaceId, userId])
  @@index([userId])
}

/// Workspace.spaces[] in Mongo; each space had its own _id, which Todo.spaceId and
/// WorkspaceInviteLink.space point to. Order by createdAt to get the old array order.
model Space {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Trimmed; at most 50 characters (Mongoose maxlength).
  name        String    @db.VarChar(50)
  createdAt   DateTime  @default(now())

  todos       Todo[]
  inviteLinks WorkspaceInviteLink[]

  @@index([workspaceId])
}

model WorkspaceInviteLink {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Set when the link is for one space.
  spaceId     String?
  space       Space?    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  /// URL-safe random token. Generate it with generateInviteToken() (src/db/defaults.ts);
  /// Mongo's default was crypto.randomBytes(24).toString('base64url').
  token       String    @unique
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  /// null = never expires.
  expiresAt   DateTime?
  /// null = unlimited.
  maxUses     Int?
  useCount    Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId, isActive])
}

enum ActivityAction {
  task_created
  task_completed
  task_assigned
  task_unassigned
  task_status_changed
  task_priority_changed
  task_due_date_changed
  task_content_changed
  member_joined
  member_removed
  workspace_created
}

model ActivityLog {
  id           String         @id @default(cuid())
  workspaceId  String
  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actorId      String
  actor        User           @relation("ActivityActor", fields: [actorId], references: [id], onDelete: Cascade)
  action       ActivityAction
  targetTaskId String?
  targetTask   Todo?          @relation(fields: [targetTaskId], references: [id], onDelete: SetNull)
  targetUserId String?
  targetUser   User?          @relation("ActivityTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  /// Free-form text (e.g. a task-title snapshot or status change), as in Mongo.
  metadata     String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([actorId])
  @@index([targetTaskId])
}

// ============================================================================
// Notifications, recent visits
// ============================================================================

enum NotificationCategory {
  actionable
  informational
  promotional
}

enum NotificationStatus {
  pending
  accepted
  declined
  dismissed
}

model Notification {
  id           String               @id @default(cuid())
  recipientId  String
  recipient    User                 @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  senderId     String?
  sender       User?                @relation("NotificationSender", fields: [senderId], references: [id], onDelete: SetNull)
  category     NotificationCategory
  /// Free-form: workspace_invite, task_assigned, task_reminder, …
  type         String
  title        String
  message      String               @default("")
  icon         String?
  /// Flexible payload per type. Queried by metadata.workspaceId: use a Prisma JSON path filter
  /// ({ path: ['workspaceId'], equals: id }). Ids inside are plain strings now.
  metadata     Json                 @default("{}")
  status       NotificationStatus   @default(pending)
  isRead       Boolean              @default(false)
  /// Don't show before this time.
  scheduledFor DateTime?
  expiresAt    DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([recipientId, isRead, createdAt(sort: Desc)])
  @@index([recipientId, status])
  @@index([recipientId, type])
  @@index([senderId])
}

/// 'slide' stays accepted because the unchanged frontend still records slide visits.
enum RecentVisitItemType {
  doc
  slide
  workspace
}

/// No createdAt/updatedAt (Mongo had timestamps: false).
model RecentVisit {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Plain id string of the visited item (no foreign key: it can be a doc, slide or workspace).
  itemId    String
  itemType  RecentVisitItemType
  title     String              @default("Untitled")
  route     String
  visitedAt DateTime            @default(now())

  @@unique([userId, itemId])
  @@index([userId, visitedAt(sort: Desc)])
}

// ============================================================================
// Reminders
// ============================================================================

/// Only todo reminders are left ('note' reminders belonged to the cut Content feature).
enum ReminderType {
  todo
}

enum ReminderStatus {
  pending
  /// Claimed by the cron while the email is being sent (the cron set it, but it was missing
  /// from the Mongo enum).
  processing
  sent
  failed
  cancelled
}

model Reminder {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         ReminderType   @default(todo)
  todoId       String
  todo         Todo           @relation(fields: [todoId], references: [id], onDelete: Cascade)
  reminderDate DateTime
  /// The phone app holds this reminder (app 0.5.0): it rings there at its time, so no email goes. A new
  /// time is a new row (the writers delete and create), and an undone cancel clears it.
  phoneAt      DateTime?
  message      String         @default("")
  emailSent    Boolean        @default(false)
  status       ReminderStatus @default(pending)
  /// Stage 7 (V2): a silent one shows on the home picture and in the app at its time (and 2 hours past it),
  /// with no sound and no email. The chat and agents set silent ones unless he says alarm or ring.
  silent       Boolean        @default(false)
  /// daily | weekdays | weekly, or none: when one passes, the next of its series is made; cancelling ends it.
  repeat       String?        @db.VarChar(20)
  /// The series a repeating one belongs to (its first reminder's id), or none.
  seriesId     String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([userId, reminderDate])
  @@index([seriesId])
  @@index([status, reminderDate])
  @@index([type, status])
  @@index([todoId])
}

// ============================================================================
// Learning (Revise's dashboard). Owned by a Recollect user (one Revise workspace = one user).
// @db.Date columns hold the user's LOCAL calendar day (engine DayString): write with
// dayToUtcMidnight(day), read with dayFromUtcMidnight(date). Instants stay timestamps.
// ============================================================================

enum RoutineMode {
  MASTER
  DAILY
}

enum RevisionStatus {
  pending
  done
  /// In Revise's schema; nothing writes it.
  missed
}

enum CaptureType {
  NOTE
  LINK
}

enum GoalType {
  NONE
  WEEKLY
  MONTHLY
}

enum SlotStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  SKIPPED
  PARTIAL
}

enum BlockLogStatus {
  COMPLETED
  SKIPPED
  PARTIAL
}

enum QuickNoteCategory {
  /// "Vault"
  PRIMARY
  /// "Scratch"
  TEMPORARY
}

model Subject {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  icon         String?
  /// Hex. New subjects get '#007acc' (Revise's default).
  color        String?
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  topics      Topic[]
  captures    Capture[]
  streaks     SubjectStreak[]
  history     DailyHistory[]
  goals       GoalSubject[]
  sessions    WorkSession[]
  weakSpots   WeakSpot[]
  weekTargets WeekTarget[]
  decisions   Decision[]

  @@index([userId, createdAt])
}

/// A doc + a subject + its revisions.
model Topic {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId    String
  subject      Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  /// The content. SET NULL when the doc is deleted: the topic and its revision history survive,
  /// and POST /api/topics/:id/doc creates a fresh doc.
  docId        String?
  doc          Doc?        @relation(fields: [docId], references: [id], onDelete: SetNull)
  /// Shown only when there is no doc (otherwise doc.title).
  title        String
  /// Revise's per-subject Tag rows, as names.
  tags         String[]    @default([])
  sortOrder    Float?
  /// Where it is on its subject's path (BUDDY_PLAN B1). Existing topics were learned: done.
  status       TopicStatus @default(done)
  startedAt    DateTime?
  doneAt       DateTime?
  /// What to do next on it, written by an agent (at most 300 characters).
  nextStep     String?     @db.VarChar(300)
  isArchived   Boolean     @default(false)
  /// Imported topics only: Revise canvasData verbatim, for a later read-only canvas view. Never edited.
  legacyCanvas Json?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  revisions   Revision[]
  captures    Capture[]
  sessions    WorkSession[]
  weakSpots   WeakSpot[]
  weekTargets WeekTarget[]

  @@unique([userId, docId])
  @@index([subjectId])
}

/// Revise NOTE/LINK captures: the Inbox and "Note" revisions. (TASK captures became Todos.)
model Capture {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          CaptureType @default(NOTE)
  title         String?
  content       String?
  url           String?
  /// LINK that is an uploaded file.
  cloudPublicId String?
  fileType      String?
  /// Revise NoteCategory.name (the "#tag").
  category      String?
  isPinned      Boolean     @default(false)
  subjectId     String?
  subject       Subject?    @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topicId       String?
  topic         Topic?      @relation(fields: [topicId], references: [id], onDelete: SetNull)
  /// [{ url, publicId, fileName, fileType }]
  attachments   Json        @default("[]")
  /// STUDY_FLOW_PLAN §4.3 (11-23): who wrote it; a chat's note says "from <app>" in the doc's sidebar.
  createdBy     CreatedBy   @default(user)
  agentName     String?     @db.VarChar(60)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  /// DOC_PAGES_PLAN D4 (11-27): the page the note was written on. Its lesson stays topicId. SET NULL: the note outlives
  /// the page.
  docId String?
  doc   Doc?    @relation(fields: [docId], references: [id], onDelete: SetNull)

  revisions Revision[]

  @@index([userId, subjectId, createdAt(sort: Desc)])
  @@index([topicId])
  @@index([docId])
}

model Revision {
  id           String         @id @default(cuid())
  /// Owner, copied from the topic/capture so dashboard queries need no joins.
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Exactly one of topicId / captureId is set (CHECK constraint in the migration SQL).
  topicId      String?
  topic        Topic?         @relation(fields: [topicId], references: [id], onDelete: Cascade)
  captureId    String?
  capture      Capture?       @relation(fields: [captureId], references: [id], onDelete: Cascade)
  /// 1..4
  cycleNumber  Int
  /// 1, 3, 7, 21
  intervalDays Int
  scheduledFor DateTime       @db.Date
  completedAt  DateTime?
  status       RevisionStatus @default(pending)
  /// engine CompletionUndo { revisionId, completedDay, shifts[] }: set by complete, cleared by uncomplete.
  undo         Json?
  createdAt    DateTime       @default(now())

  /// Recall mode: the question sets for this review (at most one unfinished).
  recallSets RecallSet[]

  @@unique([topicId, cycleNumber])
  @@unique([captureId, cycleNumber])
  @@index([userId, status, scheduledFor])
  @@index([userId, completedAt])
}

model SubjectStreak {
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId        String
  subject          Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  currentStreak    Int       @default(0)
  longestStreak    Int       @default(0)
  /// Revise lastCalculated (its epoch default becomes NULL).
  lastCreditDay    DateTime? @db.Date
  beforeLastCredit Json?

  @@id([userId, subjectId])
}

model DailyHistory {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId        String
  subject          Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  date             DateTime @db.Date
  revisionsDue     Int
  revisionsDone    Int
  streakMaintained Boolean

  @@unique([userId, subjectId, date])
}

model TimeBlock {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  /// 'HH:mm'
  startTime String
  endTime   String
  color     String
  /// 0 = Mon … 6 = Sun (DAILY routine); null for MASTER blocks and one-offs.
  dayOfWeek Int?
  /// Set = a one-off block for that day only.
  date      DateTime? @db.Date
  createdAt DateTime  @default(now())

  sessionLogs BlockSessionLog[]
  slots       DailyScheduleSlot[]

  @@index([userId])
}

model BlockSessionLog {
  id          String         @id @default(cuid())
  timeBlockId String
  timeBlock   TimeBlock      @relation(fields: [timeBlockId], references: [id], onDelete: Cascade)
  date        DateTime       @db.Date
  status      BlockLogStatus
  remark      String?
  minutesDone Int?
  createdAt   DateTime       @default(now())

  @@unique([timeBlockId, date])
  @@index([date])
}

model DailyScheduleSlot {
  id              String     @id @default(cuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceBlockId   String?
  sourceBlock     TimeBlock? @relation(fields: [sourceBlockId], references: [id], onDelete: SetNull)
  date            DateTime   @db.Date
  title           String
  color           String
  startTime       String
  endTime         String
  status          SlotStatus @default(UPCOMING)
  actualStartTime String?
  actualEndTime   String?
  remark          String?
  minutesDone     Int?
  sortOrder       Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([sourceBlockId, date])
  @@index([userId, date])
}

model DayDebrief {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date            DateTime @db.Date
  blocksPlanned   Int      @default(0)
  blocksCompleted Int      @default(0)
  blocksSkipped   Int      @default(0)
  totalFocusedMin Int      @default(0)
  /// 1-5
  energy          Int?
  focus           Int?
  mood            Int?
  tags            String[] @default([])
  narrative       String?
  tomorrowIntent  String?
  freeWrite       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, date])
}

model QuickNote {
  /// Client-made UUID: the widget upserts by id for optimistic saves. No default.
  id          String            @id
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  content     String
  isPinned    Boolean           @default(false)
  category    QuickNoteCategory @default(PRIMARY)
  /// [{ url, publicId, fileName, fileType }]
  attachments Json              @default("[]")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([userId, createdAt])
}

// ============================================================================
// Daily loop v2 (LOOP_V2_SPEC §3–4): focus lines and goals with deadlines.
// ============================================================================

/// One of up to 3 focus lines for a local day (no times). A 4th → 409 FOCUS_LIMIT.
model FocusItem {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The user's local day.
  day       DateTime  @db.Date
  /// Trimmed; at most 140 characters.
  text      String    @db.VarChar(140)
  done      Boolean   @default(false)
  /// When it was ticked (11-22: the buddy reacts to the day; null when not done, or ticked before this column).
  doneAt    DateTime?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  /// Provenance: 'agent' when an access token (an agent) created it; agentName = the agent's name.
  createdBy CreatedBy @default(user)
  agentName String?   @db.VarChar(60)

  @@index([userId, day])
}

/// A topic's place on its subject's path (BUDDY_PLAN B1).
enum TopicStatus {
  planned
  in_progress
  done
  skipped
}

enum GoalStatus {
  active
  done
  archived
}

/// A goal with a deadline ("Goals" in the UI means only these; Todo.goalType weekly/monthly items
/// are "This week" / "This month" todos). At most 3 active → 409 GOAL_LIMIT.
model Goal {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Trimmed; at most 120 characters.
  title     String     @db.VarChar(120)
  /// At most 500 characters.
  why       String?    @db.VarChar(500)
  /// The user's local day.
  deadline  DateTime   @db.Date
  status    GoalStatus @default(active)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  /// Provenance: 'agent' when an access token (an agent) created it; agentName = the agent's name.
  createdBy CreatedBy  @default(user)
  agentName String?    @db.VarChar(60)

  subjects   GoalSubject[]
  milestones GoalMilestone[]
  projects   Project[]

  @@index([userId, status])
}

/// Goal ↔ Subject (many-to-many): revisions of an active goal's subjects come first in Today's plan.
model GoalSubject {
  goalId    String
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([goalId, subjectId])
  @@index([subjectId])
}

model GoalMilestone {
  id        String    @id @default(cuid())
  goalId    String
  goal      Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)
  /// Trimmed; at most 140 characters.
  title     String    @db.VarChar(140)
  /// The user's local day, optional.
  dueDay    DateTime? @db.Date
  done      Boolean   @default(false)
  /// Set when `done` becomes true, cleared when it becomes false.
  doneAt    DateTime?
  sortOrder Int       @default(0)
  /// Provenance: 'agent' when an access token (an agent) created it; agentName = the agent's name.
  createdBy CreatedBy @default(user)
  agentName String?   @db.VarChar(60)

  weekTargets WeekTarget[]

  @@index([goalId, sortOrder])
}

// ============================================================================
// Agents (Phase C1, HOME_DOCS_AGENT_PLAN §3): a coding agent (Claude Code through the MCP server)
// reads and writes docs and learning data with a personal access token. Every agent write is logged
// (AgentEdit: Home's "From your agent", Undo); doc writes keep the state from before (DocSnapshot).
// ============================================================================

/// Who created a goal, milestone or focus line.
enum CreatedBy {
  user
  agent
}

enum AgentEditKind {
  doc_create
  doc_append
  doc_replace_section
  /// update_canvas: a board changed in place (Undo takes the agent's exact change back, like doc_append).
  doc_canvas_update
  /// update_doc: a doc renamed, filed under a subject or made a planned topic's note (Undo puts each back).
  doc_update
  /// The new editor's blocks (insert, update, move, delete by block id; DocOps): Undo takes the exact change back.
  doc_blocks
  goal_create
  goal_update
  milestone_add
  milestone_update
  /// A milestone an agent removed (Undo puts it back, with its id).
  milestone_remove
  focus_add
  /// A focus line an agent changed (text or done; Undo puts the old values back).
  focus_update
  /// A focus line an agent removed (Undo puts it back, with its id).
  focus_remove
  /// Planned topics an agent put on a subject's path (Undo removes them while still planned and docless).
  path_plan
  /// A topic an agent changed on its path (title, status, next step, place; Undo puts them back).
  topic_update
  pocket_add
  revision_schedule
  subject_create
  /// A week target an agent added (Undo removes it) or changed (Undo puts the old fields back).
  week_target_create
  week_target_update
  /// A personal task an agent added (Undo deletes it) or changed (Undo puts the old fields back).
  task_create
  task_update
  /// A decision an agent logged (Undo deletes it) or changed (Undo puts the old fields back).
  decision_create
  decision_update
  /// A doc an agent moved to the trash (Undo restores it) or restored (Undo puts it back in the trash).
  doc_trash
  doc_restore
  /// A revision an agent marked done (Undo marks it not done) or moved to another day (Undo moves it back).
  revision_complete
  revision_reschedule
  /// Learning settings an agent changed (Undo puts the old values back).
  settings_update
  /// A project an agent changed: name, goal, next step, archived (Undo puts the old fields back).
  project_update
  /// A reminder an agent set on a task, or with a new task (Undo cancels it, and deletes that task).
  reminder_set
  /// A reminder an agent cancelled (Undo sets it again while its time is still ahead).
  reminder_cancel
  /// Overdue reviews an agent spread over the next days (Undo puts each back on its old day).
  revisions_spread
  /// A memory about the user an agent closed (forget; Undo makes it active again).
  memory_close
  /// TOOL_ACCESS_PLAN §4.7: a pocket note an agent changed (Undo puts its text and pin back) or deleted (Undo brings
  /// it back with its id), only while the person lets chats at their pocket.
  pocket_update
  pocket_delete
  /// A subject an agent renamed or described (Undo puts the old values back), or deleted (Undo is the app's own week
  /// of undo for a deleted subject).
  subject_update
  subject_delete
  /// TOOL_ACCESS_PLAN §11: a file an agent attached to a note (Undo takes it off, and out of storage) or took off one
  /// (Undo puts it back while the stored file is kept).
  note_file_add
  note_file_remove
}

/// TOOL_ACCESS_PLAN §6.5: tool calls on the MCP doors, counted per day. No user, no arguments, no text: the product's
/// view of which tools are used, which fail on their inputs, and what models look for and don't find.
model McpToolStat {
  /// YYYY-MM-DD (UTC).
  day     String @db.VarChar(10)
  door    String @db.VarChar(12)
  /// The token's name: "ChatGPT", "Claude", "Claude Code"…
  app     String @db.VarChar(60)
  tool    String @db.VarChar(60)
  /// direct, use_tool or use_read_tool.
  via     String @db.VarChar(16)
  /// ok, tool_error, bad_args, unknown_tool, not_reachable, no_match or limited.
  outcome String @db.VarChar(16)
  count   Int    @default(0)
  msTotal Int    @default(0)

  @@id([day, door, app, tool, via, outcome])
}

/// A personal access token (Settings → Tokens): `Authorization: Bearer rcl_…`. Only the SHA-256 of
/// the token is stored; the plain token is shown once, when it is created.
model ApiToken {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Trimmed; at most 100 characters.
  name          String       @db.VarChar(100)
  /// SHA-256 (hex) of the whole token.
  tokenHash     String       @unique
  /// The token's first 12 characters, for display ("rcl_ab12cd34").
  prefix        String       @db.VarChar(12)
  /// A subset of 'read', 'docs:write', 'learning:write'.
  scopes        String[]
  /// Updated at most once a minute.
  lastUsedAt    DateTime?
  /// Set = revoked (the token stops working; the row stays for the list).
  revokedAt     DateTime?
  createdAt     DateTime     @default(now())
  /// Set = the token stops working then (a sign-in's access token: an hour, renewed in place by its
  /// refresh token). Null = until revoked (tokens he makes in Settings → Agents).
  expiresAt     DateTime?
  /// The OAuth client a sign-in issued this token to (claude.ai's connector), else null.
  oauthClientId String?
  oauthClient   OAuthClient? @relation(fields: [oauthClientId], references: [id], onDelete: SetNull)

  edits         AgentEdit[]
  refreshTokens OAuthRefreshToken[]

  @@index([userId, createdAt])
}

/// An app that signs in to Recollect with OAuth (ALWAYS_ON_SPEC 6.5): claude.ai's connector, Claude Code.
model OAuthClient {
  /// The client_id: random for a registered client (DCR); the metadata document's URL (CIMD).
  id           String   @id
  name         String   @db.VarChar(200)
  redirectUris String[]
  /// 'dcr' (it registered) or 'cimd' (its metadata document, refetched when the cache runs out).
  kind         String   @db.VarChar(10)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tokens ApiToken[]
  codes  OAuthCode[]
}

/// A one-time authorization code (10 minutes), bound to the client, the redirect, PKCE and the scopes.
model OAuthCode {
  id            String      @id @default(cuid())
  /// SHA-256 (hex) of the code.
  codeHash      String      @unique
  clientId      String
  client        OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  redirectUri   String
  codeChallenge String
  scopes        String[]
  resource      String
  expiresAt     DateTime
  usedAt        DateTime?
  /// The access token the code was exchanged for (a replayed code revokes it).
  apiTokenId    String?
  createdAt     DateTime    @default(now())

  @@index([expiresAt])
}

/// EASY_SETUP_PLAN §3.2 (11-23): a PC signing in by approval (`npx recollect-setup`, RFC 8628's device flow). The
/// command holds the device code and shows the user code; the person approves that code on the web app while signed
/// in; the command's next poll gets a token of its own (made then, shown once). 10 minutes, one use.
model DeviceSignIn {
  id             String    @id @default(cuid())
  /// SHA-256 (hex) of the device code (the command's secret).
  deviceCodeHash String    @unique
  /// The code the person sees and approves, upper case without its dash ("BCDFGHJK").
  userCode       String    @unique @db.VarChar(16)
  /// What the PC says it is (its name and system), shown on the approve page; never trusted for anything else.
  deviceName     String    @db.VarChar(100)
  userId         String?
  user           User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  approvedAt     DateTime?
  deniedAt       DateTime?
  /// Set when a poll took the token (the request is used up).
  deliveredAt    DateTime?
  /// The token the poll made.
  apiTokenId     String?
  lastPollAt     DateTime?
  expiresAt      DateTime
  createdAt      DateTime  @default(now())

  @@index([expiresAt])
}

/// A refresh token of a sign-in (30 days, rotated on every use; a second use revokes the connection).
model OAuthRefreshToken {
  id         String    @id @default(cuid())
  /// SHA-256 (hex) of the token.
  tokenHash  String    @unique
  apiTokenId String
  apiToken   ApiToken  @relation(fields: [apiTokenId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  /// Set when it was exchanged for a new pair.
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([apiTokenId])
}

/// A doc's whole Yjs state just before an agent edit, for Undo.
model DocSnapshot {
  id          String   @id @default(cuid())
  docId       String
  doc         Doc      @relation(fields: [docId], references: [id], onDelete: Cascade)
  /// The doc's Yjs state before the edit, as bytes (the format of Doc.yjsState).
  yjsState    Bytes
  /// The Yjs update the agent applied on top of `yjsState`, as bytes. Undo reverts exactly this change,
  /// so what people typed after it is kept. Null = Undo restores the whole snapshot.
  agentUpdate Bytes?
  createdAt   DateTime @default(now())

  edits AgentEdit[]

  @@index([docId, createdAt])
}

/// One agent write (Home's "From your agent": Open / Keep = seen / Undo).
model AgentEdit {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The token the agent used (null for a cookie session, or after the token row is deleted).
  tokenId    String?
  token      ApiToken?     @relation(fields: [tokenId], references: [id], onDelete: SetNull)
  docId      String?
  doc        Doc?          @relation(fields: [docId], references: [id], onDelete: Cascade)
  kind       AgentEditKind
  /// The X-Agent-Name header, or the token's name.
  agentName  String        @db.VarChar(60)
  /// A short human line, e.g. `Added 3 paragraphs to "Postgres locks"`.
  summary    String        @db.VarChar(300)
  /// Doc edits: the state before the edit.
  snapshotId String?
  snapshot   DocSnapshot?  @relation(fields: [snapshotId], references: [id], onDelete: SetNull)
  /// The row the edit created or changed (doc, goal, milestone, focus line, quick note, topic, subject).
  entityId   String?
  /// What Undo needs besides the snapshot: previous field values, ids created along the way.
  undoData   Json?
  createdAt  DateTime      @default(now())
  undoneAt   DateTime?
  seenAt     DateTime?

  @@index([userId, createdAt(sort: Desc)])
  @@index([docId])
  @@index([snapshotId])
  @@index([tokenId])
}

/// `Idempotency-Key` header on agent POSTs: a repeat within 24 h gets the first response back.
model IdempotencyKey {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key         String   @db.VarChar(200)
  /// Method, path and a hash of the body: the same key with a different request is a 422.
  fingerprint String
  /// Null while the first request is still running.
  statusCode  Int?
  response    Json?
  createdAt   DateTime @default(now())

  @@unique([userId, key])
  @@index([createdAt])
}

// ============================================================================
// AI: Recall mode (HOME_DOCS_AGENT_PLAN §4, Phase D). Claude writes questions from a due doc,
// grades the typed answers against it, and the result moves the revision (strong → next cycle,
// partial → again in 2 days, weak → tomorrow). Every Claude call is an AiUsage row (cost from its
// `usage`), capped per user per month (AiSettings). Code: src/services/recall, src/services/claude.
// Also: practice notes (src/services/practice: plain Docs, no table of their own) and the weekly
// coach (CoachNote, src/services/coach).
// ============================================================================

/// A question set's state. `pending` = waiting for the nightly Message Batch to write it.
enum RecallSetStatus {
  pending
  ready
  failed
}

/// One answer's grade, and a whole set's result.
enum RecallGrade {
  strong
  partial
  weak
}

/// "Knew it" / "Didn't know": graded without a model call.
enum RecallSelfMark {
  knew
  didnt
}

/// What an AI call was for (the spend meter's rows).
enum AiFeature {
  recall_questions
  recall_grade
  practice_note
  weekly_coach
  /// The `@ai` task line (LOOP_COMPLETE_SPEC 4.1).
  task_parse
  /// The Ask AI manager (MANAGER_AND_DOCS_PLAN §3.4).
  assistant
  /// Ask AI inside a doc (DOCS_EDITOR_V2_PLAN phase 5).
  doc_ask
  /// The buddy (BUDDY_MEMORY_PLAN §5): the gate, the digest, the night, the pulses, the lock-screen check.
  buddy_gate
  buddy_digest
  buddy_think
  buddy_pulse
  buddy_check
  /// B9: the work summariser (what he did, per session and day).
  buddy_work
}

/// The questions for one review (one revision) of a doc or capture. At most one unfinished set per
/// revision: the services create and take over sets only under a row lock on the revision.
model RecallSet {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  revisionId  String
  revision    Revision        @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  /// The doc the questions were written from (topic revisions); null for captures. SET NULL when
  /// the doc is deleted (the set and its attempts stay).
  docId       String?
  doc         Doc?            @relation(fields: [docId], references: [id], onDelete: SetNull)
  /// The revision's cycle when the set was written (1..4).
  cycleNumber Int
  /// [{ id, kind, prompt, answerKey, sourceQuote }]. answerKey never goes to the client; the
  /// sourceQuote only as the quote of a self-marked answer.
  questions   Json            @default("[]")
  status      RecallSetStatus
  /// The model that wrote the questions (or will: the batch's model while pending).
  model       String          @db.VarChar(100)
  /// The Message Batch writing (or that wrote) the questions; null for sets written on demand.
  batchId     String?         @db.VarChar(100)
  /// Why the questions could not be written (status failed).
  error       String?         @db.VarChar(500)
  createdAt   DateTime        @default(now())
  finishedAt  DateTime?
  result      RecallGrade?
  /// The finish response { result, effect, counts }, so a second finish returns it unchanged.
  outcome     Json?

  attempts RecallAttempt[]

  @@index([revisionId, finishedAt])
  @@index([userId, createdAt])
  @@index([batchId])
}

/// One answer to one question of a set (re-answering replaces it).
model RecallAttempt {
  id         String          @id @default(cuid())
  setId      String
  set        RecallSet       @relation(fields: [setId], references: [id], onDelete: Cascade)
  questionId String          @db.VarChar(20)
  /// The typed answer; null for a self-mark.
  answer     String?
  selfMark   RecallSelfMark?
  grade      RecallGrade
  /// At most two sentences: what was missing or wrong. '' for a self-mark or a complete answer.
  feedback   String          @default("")
  /// The doc's own passage that answers the question.
  quote      String?
  createdAt  DateTime        @default(now())

  @@unique([setId, questionId])
}

/// One Claude API call or one Message Batch request: its tokens and cost (spend meter, monthly cap).
model AiUsage {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature          AiFeature
  /// The model that produced the answer (a refusal fallback's model when one served it).
  model            String    @db.VarChar(100)
  /// Uncached input tokens.
  inputTokens      Int       @default(0)
  outputTokens     Int       @default(0)
  cacheReadTokens  Int       @default(0)
  cacheWriteTokens Int       @default(0)
  /// A Message Batch request (half price).
  batch            Boolean   @default(false)
  /// From src/services/claude/pricing.ts at the time of the call.
  costUsd          Decimal   @db.Decimal(10, 6)
  /// Which key paid: "house" (the server's) or "own" (the person's own key, later). Text, not an enum,
  /// so a new kind never breaks an older release (ECOSYSTEM_V2_PLAN §10.1).
  source           String    @default("house") @db.VarChar(10)
  createdAt        DateTime  @default(now())

  @@index([userId, createdAt])
}

/// Whether a Claude API key works now (ECOSYSTEM_V2_PLAN §4.15, stage 2): the server's key ("house") and,
/// later, a person's own. A key that ran out of credit or was rejected is paused for every account that
/// uses it: no call is made on it until a probe succeeds (every 6 hours, or the user's "Try again").
/// "Busy" and network faults never pause a key. No row: the key is fine.
model AiKeyState {
  keyId      String    @id @db.VarChar(64)
  /// ok | no_credit | bad_key (text, so a new state never breaks an older release)
  state      String    @default("ok") @db.VarChar(20)
  /// When it entered this state.
  since      DateTime  @default(now())
  /// The API's own words for the failure (never the key).
  lastError  String?   @db.VarChar(300)
  /// When a paused key is probed next.
  probeAt    DateTime?
  /// Stage 4 (hold and replay): the last pause, once over, so the first night back is told which days
  /// the buddy could not listen.
  pausedFrom DateTime?
  pausedTo   DateTime?
  updatedAt  DateTime  @updatedAt
}

/// Stage 10 (ECOSYSTEM_V2_PLAN §9.3): a person's own Claude API key, encrypted (AES-256-GCM with AI_KEYS_SECRET).
/// Never returned or logged: only its last 4 show. One at a time; a removed one keeps its row (removedAt).
model AiKey {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// anthropic (the door stays open for others)
  provider  String    @default("anthropic") @db.VarChar(20)
  cipher    String
  iv        String    @db.VarChar(32)
  tag       String    @db.VarChar(32)
  last4     String    @db.VarChar(4)
  checkedAt DateTime?
  createdAt DateTime  @default(now())
  removedAt DateTime?

  @@index([userId, removedAt])
}

/// Per-user AI settings (Settings → AI). No row = the defaults.
model AiSettings {
  userId        String   @id
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Questions and grading stop for the rest of the (local) month once spend reaches this.
  monthlyCapUsd Decimal  @default(50) @db.Decimal(10, 2)
  /// Stage 11: a friend's limit a day on the server's key (the owner sets it on the People page). Null: $1.
  /// Only an account on a free allowance is held to it.
  dailyCapUsd   Decimal? @db.Decimal(10, 2)
  updatedAt     DateTime @updatedAt
}

/// Stage 11 (ECOSYSTEM_V2_PLAN stage 11, his decision 1): free AI the owner gives a person on the server's key: the
/// first allowance when their invite is used, then each top-up. The person uses the server's key while what was
/// given exceeds their spend on it since the first grant (AiUsage, source "house").
model AiGrant {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("AiGrantTo", fields: [userId], references: [id], onDelete: Cascade)
  amountUsd Decimal  @db.Decimal(10, 2)
  /// Who gave it (the owner); null once that account is gone.
  givenById String?
  givenBy   User?    @relation("AiGrantBy", fields: [givenById], references: [id], onDelete: SetNull)
  note      String   @default("") @db.VarChar(200)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// Stage 11: a one-time invite link the owner makes on the People page: the only way in while signup is closed.
/// It lets that email make an account once (with the email's code or Google, which prove the address), within 14
/// days, unless revoked; its allowance becomes the person's first AiGrant.
model SignupInvite {
  id           String    @id @default(cuid())
  /// Lower-cased.
  email        String    @db.VarChar(320)
  /// The name the owner typed (the signup form starts with it).
  name         String    @default("") @db.VarChar(50)
  /// In the link (/signup?invite=…); random, unique.
  code         String    @unique @db.VarChar(64)
  allowanceUsd Decimal   @default(5) @db.Decimal(10, 2)
  invitedById  String?
  invitedBy    User?     @relation("InviteBy", fields: [invitedById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  usedAt       DateTime?
  usedById     String?
  usedBy       User?     @relation("InviteUsedBy", fields: [usedById], references: [id], onDelete: SetNull)
  revokedAt    DateTime?

  @@index([email])
}

/// Stage 11: a setting of the whole server the owner changes in the app (the friends' monthly ceiling). Key → JSON.
model ServerSetting {
  key       String   @id @db.VarChar(64)
  value     Json
  updatedAt DateTime @updatedAt
}

/// Stage 11 (§9.6 item 5, his item 10d): what a person sends the owner: words from "Send feedback" (kind
/// "feedback"), or the phone app's diagnostics (kind "diagnostics": the model, Android version, screen size,
/// permissions and last update times in `details`; nothing personal). Shown on the People page.
model Feedback {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// feedback | diagnostics (text, so a new kind never breaks an older release)
  kind      String   @default("feedback") @db.VarChar(20)
  text      String   @default("") @db.VarChar(4000)
  /// web | phone
  source    String   @default("web") @db.VarChar(10)
  /// Where it was sent from (a page path) or the diagnostics.
  details   Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([kind, createdAt])
}

/// A Message Batch the nightly job submitted. The poller stores its results once it has ended.
model AiBatch {
  /// Anthropic's batch id (msgbatch_…).
  id           String    @id @db.VarChar(100)
  feature      AiFeature
  model        String    @db.VarChar(100)
  /// { [custom_id]: userId }: who pays for each request, even if its set or revision is gone.
  owners       Json      @default("{}")
  requestCount Int
  createdAt    DateTime  @default(now())
  /// Set once the results are stored (or the batch is given up on).
  endedAt      DateTime?
  /// What the poller saw, e.g. "4 succeeded, 1 errored".
  summary      String?   @db.VarChar(300)

  @@index([endedAt])
}

/// A weekly coach note (Home's weekly review): five lines on the 7 days ending the day before it
/// was written (the user's zone) and 3 suggested focus lines. POST /api/ai/coach writes one; a
/// second POST the same local day returns it unless ?fresh=1. Code: src/services/coach.
model CoachNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The window's first and last local days (weekEnd = the day before the note was written).
  weekStart DateTime @db.Date
  weekEnd   DateTime @db.Date
  /// { strong, slipping, fix, deadline }: one or two sentences each, at most 220 characters.
  lines     Json
  /// Exactly 3 suggested focus lines, each at most 140 characters (a FocusItem's limit).
  focus     Json
  /// The model that wrote it; 'none' = a week with nothing in it, written without a model call.
  model     String   @db.VarChar(100)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ─── The record (SYNC_SPINE_SPEC 1.2) ─────────────────────────────────────────
// One WorkSession per piece of work, written by an agent (checkpoint), a Claude Code hook, or by
// hand. Session writes are not AgentEdit rows: the list is their log (each row says who wrote it,
// and the user can change or delete any). Weak spots go from study chats to Recall and back.

enum SessionKind {
  study
  practice
  build
  review
}

/**
 * practice: how the problem was solved.
 */
enum PracticeOutcome {
  alone
  hints
  after_answer
}

/// PERSONAL_OFFICE_PLAN (11-23): whose time a session is. Work is tracked for time and the work log; it counts as
/// progress only for a person who says so (User.progressIncludesWork).
enum SessionArea {
  personal
  work
}

/// PERSONAL_OFFICE_PLAN (11-23): what a folder is, chosen in the app (Settings › Tracking): the server's word for every
/// PC. Personal: their own project (build). Study: a folder they learn in (study, no work log). Work: their job.
enum ProjectKind {
  personal
  study
  work
}

/// EASY_SETUP_PLAN (11-23): what is logged in a folder. full: the time, their words for the buddy, the work log;
/// light: the time only; off: nothing (the hooks leave it alone). A folder without one: its kind's (work light, else full).
enum FolderTracking {
  full
  light
  off
}

/// EASY_SETUP_PLAN §7 (11-23): who decided what a folder or a chat is, least trusted first. A folder: pc (a PC's first
/// guess), chat (their answer in a chat: set_folder), app (Settings › Tracking); none yet = not decided. A chat: folder
/// (it follows its folder), agent (the agent's judgement, said in one line), chat (their own words, /study, /personal,
/// /work), app (the session row). A later, more trusted choice wins; a folder's change moves only chats that follow it.
enum KindSetBy {
  folder
  pc
  agent
  chat
  app
}

/// EASY_SETUP_PLAN §3.5 (11-23): what a folder the server has never seen is.
enum NewFolders {
  ask
  personal
  study
  work
  off
}

enum SessionSource {
  agent
  hook
  user
}

enum WeakSpotStatus {
  open
  cleared
}

enum WeakSpotSource {
  session
  recall
}

model WorkSession {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The writer's key (checkpoint "s_…", a Claude Code session "cc_…"); null for a manual entry.
  key        String?          @db.VarChar(80)
  kind       SessionKind      @default(study)
  /// The user's local day it started.
  day        DateTime         @db.Date
  startedAt  DateTime
  endedAt    DateTime?
  minutes    Int?
  subjectId  String?
  subject    Subject?         @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topicId    String?
  topic      Topic?           @relation(fields: [topicId], references: [id], onDelete: SetNull)
  projectId  String?
  project    Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  /// What was done.
  title      String           @db.VarChar(200)
  scoreDone  Int?
  scoreTotal Int?
  outcome    PracticeOutcome?
  problem    String?          @db.VarChar(200)
  url        String?          @db.VarChar(500)
  nextStep   String?          @db.VarChar(300)
  /// build: { branch, commits: string[≤ 10] }.
  details    Json?
  source     SessionSource    @default(user)
  agentName  String?          @db.VarChar(60)
  /// PERSONAL_OFFICE_PLAN: the folder's area, copied (a work folder's sessions are work); moves with the folder's kind.
  area       SessionArea      @default(personal)
  /// EASY_SETUP_PLAN §7: who set what this chat is (its area and kind); `folder` = it follows its folder.
  kindSetBy  KindSetBy        @default(folder)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  weakSpots WeakSpot[]

  @@unique([userId, key])
  @@index([userId, day])
  @@index([userId, area, day])
}

/// Where build sessions belong: a repo or a piece of work (the folder name is its key).
model Project {
  id         String          @id @default(cuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The folder name, lower case.
  key        String          @db.VarChar(100)
  name       String          @db.VarChar(120)
  goalId     String?
  goal       Goal?           @relation(fields: [goalId], references: [id], onDelete: SetNull)
  nextStep   String?         @db.VarChar(300)
  isArchived Boolean         @default(false)
  /// PERSONAL_OFFICE_PLAN: personal, study or work; a new folder takes the PC's hint, the app's choice wins after.
  kind       ProjectKind     @default(personal)
  /// EASY_SETUP_PLAN: what is logged here; null = its kind's default (work: light; else full).
  tracking   FolderTracking?
  /// EASY_SETUP_PLAN: who decided what it is (pc, chat, app); null = nobody yet (a new folder asks once).
  kindSetBy  KindSetBy?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  sessions    WorkSession[]
  weekTargets WeekTarget[]
  decisions   Decision[]

  @@unique([userId, key])
}

/// Something the learner got wrong or found shaky, on a topic (or a subject). Recall asks about
/// open ones first; a right answer clears it.
model WeakSpot {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId   String?
  topic     Topic?         @relation(fields: [topicId], references: [id], onDelete: Cascade)
  subjectId String?
  subject   Subject?       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  text      String         @db.VarChar(160)
  /// lower(text) with single spaces: one weak spot per text and topic.
  textKey   String         @db.VarChar(160)
  status    WeakSpotStatus @default(open)
  source    WeakSpotSource @default(session)
  sessionId String?
  session   WorkSession?   @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  createdAt DateTime       @default(now())
  clearedAt DateTime?

  @@unique([userId, topicId, textKey])
  @@index([userId, status])
  @@index([subjectId])
}

// ─── The week and suggestions (LOOP_COMPLETE_SPEC 1.6) ─────────────────────────
// A week (Monday to Sunday, his zone) holds up to 5 targets. A target is done when it is ticked, or
// when what it points at is done (a topic, a milestone, a task) or its count is reached. Proposals
// from the app, the coach or an agent are Suggestion rows: one place on Home, one tap to accept.

enum WeekTargetStatus {
  open
  done
  dropped
}

/// What a counted target counts in its week.
enum WeekMeasure {
  /// practice sessions
  practice
  /// minutes of sessions
  minutes
  /// topics finished
  topics
}

enum SuggestionKind {
  week_target
  focus_line
  profile_edit
  /// An action that needs the user's tap (the manager, stage 4): no handler yet.
  action
  /// The buddy's items from his chats (BUDDY_MEMORY_PLAN §3.6): a personal task, a note for his inbox, a decision for the journal.
  task
  note
  decision
  /// "Do this by itself from now on?" (B6).
  routine
}

enum SuggestionStatus {
  pending
  accepted
  dismissed
  /// The buddy's items from his chats, not shown until the night ranks them (BUDDY_MEMORY_PLAN §3.1).
  candidate
}

enum SuggestionProposer {
  app
  coach
  agent
  ask_ai
  /// The buddy (from his chats).
  buddy
}

model WeekTarget {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The week's Monday (the user's local day).
  weekStart   DateTime         @db.Date
  text        String           @db.VarChar(140)
  sortOrder   Int              @default(0)
  status      WeekTargetStatus @default(open)
  doneAt      DateTime?
  /// At most one link, or a count (measure + amount, optionally in a subject or a project).
  topicId     String?
  topic       Topic?           @relation(fields: [topicId], references: [id], onDelete: SetNull)
  milestoneId String?
  milestone   GoalMilestone?   @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  todoId      String?
  todo        Todo?            @relation(fields: [todoId], references: [id], onDelete: SetNull)
  measure     WeekMeasure?
  amount      Int?
  subjectId   String?
  subject     Subject?         @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  projectId   String?
  project     Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy   CreatedBy        @default(user)
  agentName   String?          @db.VarChar(60)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([userId, weekStart])
}

model Suggestion {
  id         String             @id @default(cuid())
  userId     String
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       SuggestionKind
  /// What the card says.
  text       String             @db.VarChar(200)
  reason     String?            @db.VarChar(200)
  /// What accepting does (per kind).
  payload    Json
  proposedBy SuggestionProposer
  agentName  String?            @db.VarChar(60)
  /// Proposals made together, e.g. "week:2026-11-16" (the Sunday review).
  batch      String?            @db.VarChar(40)
  status     SuggestionStatus   @default(pending)
  /// After this day a pending suggestion is no longer shown.
  expiresDay DateTime?          @db.Date
  decidedAt  DateTime?
  createdAt  DateTime           @default(now())

  @@index([userId, status])
  @@index([userId, batch])
}

// ─── The decision journal (LOOP_COMPLETE_SPEC 4.2) ─────────────────────────────
// What was decided, why, what was expected, and a day to look again. On that day Home asks "Was
// this right?" once (Right · Mixed · Wrong, or look again later). Never a red count.

enum DecisionStatus {
  open
  reviewed
}

enum DecisionVerdict {
  right
  wrong
  mixed
}

model Decision {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String           @db.VarChar(160)
  why          String           @db.VarChar(600)
  expect       String?          @db.VarChar(400)
  /// The user's local day to look again.
  lookAgainDay DateTime         @db.Date
  status       DecisionStatus   @default(open)
  verdict      DecisionVerdict?
  verdictNote  String?          @db.VarChar(400)
  reviewedAt   DateTime?
  subjectId    String?
  subject      Subject?         @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  projectId    String?
  project      Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy    CreatedBy        @default(user)
  agentName    String?          @db.VarChar(60)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  /// The buddy's memories of this decision (kind `decision`).
  memories     Memory[]

  @@index([userId, status, lookAgainDay])
  @@index([projectId])
}

// ====================================================================
// IMPORTS (LOOP_COMPLETE_SPEC S3: backend/scripts/import-revise.ts)
// ====================================================================

/// A row brought in from another app, so a second run brings only what is new.
model ImportedRow {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The app it came from: 'revise'.
  source      String   @db.VarChar(40)
  /// Its table there, e.g. 'Capture'.
  sourceTable String   @db.VarChar(60)
  sourceId    String   @db.VarChar(80)
  /// Where it went here, e.g. 'Todo'.
  targetTable String   @db.VarChar(60)
  targetId    String   @db.VarChar(80)
  importedAt  DateTime @default(now())

  @@unique([userId, source, sourceTable, sourceId])
}

// ====================================================================
// THE MANAGER (MANAGER_AND_DOCS_PLAN 3.4): Ask AI's conversations
// ====================================================================

enum AssistantRole {
  user
  assistant
}

/// One conversation with the manager: kept 90 days after its last message, deletable.
model AssistantThread {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The first line of his first message.
  title     String             @db.VarChar(120)
  /// Asked from inside this doc (its asks are not listed on /ask); gone with the doc.
  docId     String?
  /// Stage 3: the buddy's question this chat opened with (a reply in it answers or passes it).
  askId     String?            @db.VarChar(30)
  doc       Doc?               @relation(fields: [docId], references: [id], onDelete: Cascade)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  messages  AssistantMessage[]

  @@index([userId, updatedAt(sort: Desc)])
  @@index([docId])
}

model AssistantMessage {
  id          String          @id @default(cuid())
  threadId    String
  thread      AssistantThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role        AssistantRole
  text        String
  /// The tools an answer used: [{ name, level, input, result, ok, editId? }] (short forms).
  tools       Json            @default("[]")
  /// An answer's token usage and its cost.
  usage       Json?
  costUsd     Decimal?        @db.Decimal(10, 6)
  /// Stage 3: when the buddy read this message of his (null: not yet); `buddySkip`: written while he had
  /// paused the buddy, so it is never read.
  buddyReadAt DateTime?
  buddySkip   Boolean         @default(false)
  createdAt   DateTime        @default(now())

  @@index([threadId, createdAt])
}

// ── The morning notification (ALWAYS_ON_SPEC 6.3) ──

/// One browser or installed app that receives the morning notification (a Web Push subscription).
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  /// The push service URL; unique: one row per browser.
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ====================================================================
// THE BUDDY (context/specs/BUDDY_MEMORY_PLAN.md): what Recollect learns about the user from his chats,
// keeps (notes → memories → a portrait), thinks about and says. Code: src/services/buddy/.
// ====================================================================

/// What a memory is about. Lasting kinds (fact, preference, value, aim, idea, decision) never fade
/// by time; working kinds (pattern, state, thread, win) follow the present (plan §3.2).
enum MemoryKind {
  fact
  preference
  value
  aim
  idea
  decision
  pattern
  state
  thread
  win
}

/// Private: health, money, family, other people, guilt, fear, work conflicts, leaving his job. Never
/// on the lock screen or the widget; left out of the brief unless pinned.
enum Sensitivity {
  open
  private
}

enum MemoryStatus {
  active
  /// Left the buddy's mind (scored out, or a state gone quiet); still found by search, and active
  /// again the day it is seen again.
  faded
  /// No longer true (changed, done, dropped or forgotten by an agent), closed with its day and reason.
  closed
  /// The user marked it wrong: kept so the same idea is not learned again.
  wrong
}

/// Where a note or memory came from.
enum BuddySource {
  /// The Claude Code hooks (his typed words, digested).
  hook
  /// An agent's remember / checkpoint.learned.
  agent
  /// The user, in the app (/you).
  app
  /// "Tell your buddy".
  tell
  /// His thumbs on a line or note.
  feedback
  /// The buddy's own thinking (the night step).
  buddy
}

/// One row = the buddy is set up for this user. No row = the defaults (not enabled, not paused).
model BuddyState {
  userId          String    @id
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The thinking steps (they cost AI money) run only while enabled and not paused.
  enabled         Boolean   @default(false)
  /// The user's switch: no capture and no thinking while on.
  paused          Boolean   @default(false)
  /// What he calls it ("your buddy" while null).
  name            String?   @db.VarChar(40)
  /// candid | gentle
  tone            String    @default("candid") @db.VarChar(20)
  /// The portrait: who he is (≤ 120 words), where he is heading (≤ 80), right now (≤ 120).
  who             String?
  heading         String?
  now             String?
  /// The buddy's notebook for its next step (≤ 1,500 characters).
  notebook        String?
  /// The buddy's own monthly AI cap (the account's cap still applies).
  capUsd          Decimal   @default(25) @db.Decimal(10, 2)
  /// B9: keep a log of what he works on (the gate's `work` label and the work summariser). Off: the
  /// gate's request is exactly as before.
  workLog         Boolean   @default(false)
  /// ECOSYSTEM_V2_PLAN stage 12 (the owner's word, 11-20: the person chooses): connected chats (ChatGPT, Claude, Claude
  /// Code outside a work folder) see what work folders logged. Off: those lines stay in their own folder and in Recollect.
  shareOfficeWork Boolean   @default(true)
  /// Stage 16 (ECOSYSTEM_V2_PLAN): their goal on the phone's pictures and widget. Off by default (the owner, 11-20: a goal
  /// may be private, and a lock screen is seen by anyone nearby).
  goalOnScreens   Boolean   @default(false)
  /// ECOSYSTEM_V2_PLAN stage 3: the loop (threads, asks, the check when words show) is on for this
  /// account. Off: today's behaviour, at once (nothing of today's is closed while this switch exists).
  loop            Boolean   @default(false)
  /// Stage 5 (§4.9): his switch "The buddy may ask me questions" (off: no question on any surface).
  asksOn          Boolean   @default(true)
  /// The local day the night step last ran (claimed first, like lastNudgeDay).
  lastNightDay    DateTime? @db.Date
  lastStepAt      DateTime?
  updatedAt       DateTime  @updatedAt
}

/// A note about the user: raw, dated, append-only (≤ 300 characters). The night step folds notes into
/// memories (memoryId); a note saved by an agent or by him becomes a memory at once.
model Observation {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  text         String      @db.VarChar(300)
  kind         MemoryKind
  sensitivity  Sensitivity @default(open)
  source       BuddySource
  agentName    String?     @db.VarChar(60)
  sessionKey   String?     @db.VarChar(80)
  /// The project (folder) key of the session it came from.
  project      String?     @db.VarChar(100)
  /// Stage 3: when he said it (the message's own time), and the kind of source as text (ask_ai, ...).
  saidAt       DateTime?
  via          String?     @db.VarChar(20)
  /// MCP_MEMORY_PLAN §4.4: whose word an assistant passed on ('said', 'inferred'); null = own words, or an older build (passed on).
  basis        String?     @db.VarChar(10)
  /// §4.2: an update on something known (progress, done, skipped, changed, paused, resumed, dropped, finished, said); null = a new detail.
  updateKind   String?     @db.VarChar(10)
  /// §4.7: it needs the buddy's understanding, which could not run when it was saved; cleared once read or linked.
  waitingSince DateTime?
  /// §4.4: said on that day, its time unknown.
  dayOnly      Boolean     @default(false)
  /// The user's local day it was noted.
  day          DateTime    @db.Date
  memoryId     String?
  memory       Memory?     @relation(fields: [memoryId], references: [id], onDelete: SetNull)
  /// When the night step read it (folded into a memory, or judged not worth one); null = waiting.
  foldedAt     DateTime?
  createdAt    DateTime    @default(now())

  @@index([userId, day])
  @@index([memoryId])
  @@index([userId, waitingSince])
}

/// What the buddy knows about the user: the curated list (plan §3.2). His word wins: a memory he
/// added, edited, pinned or marked wrong is `byUser` and no model changes it.
model Memory {
  id           String                   @id @default(cuid())
  userId       String
  user         User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text         String                   @db.VarChar(300)
  kind         MemoryKind
  sensitivity  Sensitivity              @default(open)
  status       MemoryStatus             @default(active)
  /// Lasting memories never fade by time (the kind sets it by default).
  lasting      Boolean                  @default(true)
  pinned       Boolean                  @default(false)
  byUser       Boolean                  @default(false)
  /// Project keys and subject names, lower case: they pick the memories a chat's brief carries.
  tags         String[]                 @default([])
  /// Who first wrote it (its notes say the rest).
  source       BuddySource
  agentName    String?                  @db.VarChar(60)
  /// A decision memory's row in the decision journal.
  decisionId   String?
  decision     Decision?                @relation(fields: [decisionId], references: [id], onDelete: SetNull)
  seenCount    Int                      @default(1)
  /// Local days: first noted, last seen again.
  firstSeenDay DateTime                 @db.Date
  lastSeenDay  DateTime                 @db.Date
  /// "2026-11": the months it was seen in (three make a working memory lasting).
  monthsSeen   String[]                 @default([])
  closedDay    DateTime?                @db.Date
  closeReason  String?                  @db.VarChar(200)
  /// The memory this one replaced (a changed fact keeps its history).
  supersedesId String?
  /// MCP_MEMORY_PLAN §4.3: an assistant's conclusion, not the person's words (a working memory until their own words confirm it).
  inferred     Boolean                  @default(false)
  /// §4.3: two versions said on one day in an unknown order: marked "check" until a later statement or the person settles it.
  checkSince   DateTime?
  /// Kept by a trigger from `text` (English stems and plain words); GIN index. Raw SQL only.
  searchVector Unsupported("tsvector")?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  observations Observation[]

  @@index([userId, status, kind])
  @@index([searchVector], type: Gin)
}

/// The capture queue (BUDDY_MEMORY_PLAN §3.1): his typed words from one Claude Code session, after the
/// secret scrub, waiting for the gate and the digest. Deleted once digested; never kept past 48 hours.
model BuddyChunk {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionKey String      @db.VarChar(80)
  /// The hook's running number for this session: a retried POST is not queued twice.
  seq        Int
  project    String?     @db.VarChar(100)
  /// B9: from a folder that never gets his brief (`brief: false` in his hooks.json): office work.
  office     Boolean     @default(false)
  source     BuddySource @default(hook)
  /// Stage 3: the kind of source as text (ask_ai, answer, ...); null: the hooks.
  via        String?     @db.VarChar(20)
  /// The time its earliest message was said (the queue goes earliest said first).
  saidFrom   DateTime?
  /// [{ at, text, reply?, before?, n?, context? }]
  messages   Json
  /// Stage 4: a saved note (an agent's remember or learned, his "Tell") waiting to be linked to his
  /// threads: not raw chat, so it waits however long the AI is paused (no 48-hour limit).
  noteId     String?     @db.VarChar(40)
  attempts   Int         @default(0)
  lastError  String?     @db.VarChar(300)
  createdAt  DateTime    @default(now())

  @@unique([userId, sessionKey, seq])
  @@index([createdAt])
}

/// What capture did on one of his days (counts only, never words): the usage view and the review.
model BuddyCaptureDay {
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  day            DateTime  @db.Date
  /// Messages received, kept by the gate, chunks, dropped (paused, expired, failed), scrubbed.
  seen           Int       @default(0)
  kept           Int       @default(0)
  chunks         Int       @default(0)
  dropped        Int       @default(0)
  secrets        Int       @default(0)
  /// What the digest wrote: notes about him, items for his inbox.
  notes          Int       @default(0)
  items          Int       @default(0)
  /// B9: work lines the summariser wrote.
  work           Int       @default(0)
  /// Stage 4 (the ear meter): per source, { seen, pieces, dropped, last } (last: when it was last heard, ISO).
  bySource       Json      @default("{}")
  /// Stage 5 (§4.13): pulses on events skipped because the day's 4 were used (the usage view), and when the
  /// last one was skipped (the events before it are counted once).
  pulsesSkipped  Int       @default(0)
  pulseSkippedAt DateTime?
  /// Stage 18: the last time their own fresh words changed what is fit to say today (a plan for tonight, how today is
  /// going): a pulse on an event follows within minutes.
  todayAt        DateTime?
  /// Stage 18: those words (their own, scrubbed, the latest 400 characters), so the pulse they start knows what changed.
  todayWords     String?   @db.VarChar(400)

  @@id([userId, day])
}

/// How far the buddy has read each session (ECOSYSTEM_V2_PLAN §4.11 rule 2, stage 4): a message is known
/// by its own number in its session, not by the piece that carried it, so whatever is sent again is
/// read once, and a send whose answer was lost loses and doubles nothing.
model BuddySessionMark {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionKey String   @db.VarChar(80)
  /// The highest message number taken (read, or dropped while he had paused the buddy).
  readTo     Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, sessionKey])
}

enum BuddyStepKind {
  night
  pulse
}

/// What one thinking step wrote (BUDDY_MEMORY_PLAN §3.3): the day's three lines for the phone and
/// Home, its note (or its silence), a follow-up for his next chat, and what the guards threw out.
model BuddyDay {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// His local day the step ran for.
  day           DateTime      @db.Date
  kind          BuddyStepKind
  /// [{ slot: morning|afternoon|evening, text, form, lockOk, sourceId?, fallback? }]
  lines         Json
  note          String?       @db.VarChar(800)
  /// The lock check passed the note: the phone app may show its words in a notification (which the
  /// lock screen shows too). False when it named a private thing, wasn't checked, or the check failed.
  noteLockOk    Boolean       @default(false)
  followUp      String?       @db.VarChar(300)
  /// One thought for his home screen today (the owner, 11-16: the home screen lists what matters, such as
  /// reminders or a suggestion or insight from the buddy, never the lock screen's line), or none.
  insight       String?       @db.VarChar(200)
  /// The lock check passed the thought: the home picture may show it (others see a home screen too).
  insightLockOk Boolean       @default(false)
  /// Stage 3: what the thought and the note rest on, [{ threadId, rev }] (a line carries its own `about`).
  insightAbout  Json?
  noteAbout     Json?
  /// The memory changes applied (an audit, and what an Undo of the night would take back).
  ops           Json          @default("[]")
  /// What the op check and the guards threw out, and why (never his words).
  dropped       Json          @default("[]")
  model         String        @db.VarChar(100)
  costUsd       Decimal       @default(0) @db.Decimal(10, 6)
  /// Stage 5 (§4.13): a pulse run because a thread changed in a way that matters today (at most 4 a day),
  /// not one of the fixed pulses at 12:00 and 18:00.
  onEvent       Boolean       @default(false)
  createdAt     DateTime      @default(now())

  @@index([userId, day])
}

/// His thumbs on what the buddy said (BUDDY_MEMORY_PLAN §3.5): "more like this" or "not this" on a
/// line or the note. The night reads them beside what it said.
model BuddyFeedback {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  buddyDayId String
  /// morning | afternoon | evening | note
  target     String   @db.VarChar(20)
  /// more | less
  verdict    String   @db.VarChar(10)
  /// Stage 5b: why a "not this" (private | time | useless | wrong), when he said; and his few words.
  reason     String?  @db.VarChar(12)
  words      String?  @db.VarChar(200)
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}

/// Stage 5b (ECOSYSTEM_V2_PLAN, part B): what he told the buddy about his screens, or what a thumb taught it:
/// questions not before a time (asks_from), only on some days (asks_days), or a topic kept off the screens
/// (topic, judged by the lock check). About one thread or everything. Removed on /you (endedAt).
model BuddyScreenRule {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// asks_from | asks_days | topic
  kind      String    @db.VarChar(20)
  /// The thread it is about, or none: everything.
  threadId  String?
  /// asks_from: questions not before this minute of his day.
  fromMin   Int?
  /// asks_days: the weekdays questions may come (0 Sunday to 6 Saturday).
  days      Int[]     @default([])
  /// His words, or the line a thumb was on.
  text      String    @db.VarChar(200)
  /// said | thumb
  source    String    @db.VarChar(10)
  createdAt DateTime  @default(now())
  endedAt   DateTime?

  @@index([userId, endedAt])
}

/// What is going on in a person's life that the buddy pays attention to (ECOSYSTEM_V2_PLAN §4.1, stage 3):
/// an intention, a habit being built, an event to come, a situation. States are text, never enums, so a
/// new one never breaks an older release (§10.1).
model BuddyThread {
  id           String                   @id @default(cuid())
  userId       String
  user         User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String                   @db.VarChar(120)
  /// 3 to 8 search words, with other words for the same thing (lower case).
  keywords     String[]                 @default([])
  /// noticed | active | committed | paused | done | dropped
  stage        String                   @default("noticed") @db.VarChar(20)
  /// A day to come back to it, from his words.
  lookAgainOn  DateTime?                @db.Date
  /// none | daily | weekly: how often an update is natural, from his words.
  rhythm       String                   @default("none") @db.VarChar(10)
  /// Stage 5b: a one-time event on its day (lookAgainOn): no question before it is over, one at most after it,
  /// closed by itself a week after it.
  event        Boolean                  @default(false)
  /// Its time of day (minutes), when his words gave one.
  eventMinute  Int?
  /// A stranger reading it would learn something a person usually keeps private (§4.8).
  sensitive    Boolean                  @default(false)
  /// His switch: may its words show on his lock and home screen.
  onScreens    Boolean                  @default(true)
  /// His own instruction about it, in his words.
  steer        String?                  @db.VarChar(200)
  /// "Don't ask me about this": no words about it until he raises it himself.
  noAsk        Boolean                  @default(false)
  /// No words of any kind about it until then (§4.4).
  quietUntil   DateTime?
  goalId       String?
  taskId       String?
  /// The memory it was copied from (stage 3's copy of the old thread memories).
  memoryId     String?
  /// Goes up with every new word about it and every change of its state; an item written about it
  /// shows only while the revision is the one its writer saw (§4.5).
  revision     Int                      @default(1)
  /// When he last said something about it (the time he said it).
  lastSaidAt   DateTime
  /// His day it was first said.
  firstDay     DateTime                 @db.Date
  closedAt     DateTime?
  /// Kept by a trigger from the title and keywords (English stems and plain words); GIN index. Raw SQL only.
  searchVector Unsupported("tsvector")?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  events       BuddyThreadEvent[]
  asks         BuddyAsk[]
  reminders    BuddyReminder[]

  @@index([userId, stage])
  @@index([searchVector], type: Gin)
}

/// One dated line of a thread's history (§4.1, §4.11): what he said or did, when he said it, the day
/// it is about, whether it was his own word (direct) or passed on (an agent's note, a connector).
model BuddyThreadEvent {
  id            String      @id @default(cuid())
  userId        String
  threadId      String
  thread        BuddyThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  /// said | progress | done | skipped | finished | changed | paused | resumed | dropped | answered | steer
  kind          String      @db.VarChar(20)
  text          String      @db.VarChar(200)
  /// When he said it (for an indirect statement: no later than this).
  saidAt        DateTime
  receivedAt    DateTime    @default(now())
  /// His day it is about (his day ends at 04:00).
  forDay        DateTime    @db.Date
  direct        Boolean     @default(true)
  /// MCP_MEMORY_PLAN §4.4: an assistant passed it on as the person's word ('said') or its own conclusion ('inferred'); null = own, or older (passed on).
  basis         String?     @db.VarChar(10)
  /// §4.4: said on that day, its time unknown.
  dayOnly       Boolean     @default(false)
  /// The same thing said twice on one day: kept for the record, not counted, changes nothing.
  duplicate     Boolean     @default(false)
  /// Where it came from: hook | ask_ai | answer | agent | tell | app | ...
  via           String      @db.VarChar(20)
  observationId String?
  askId         String?
  /// The piece, the message and the operation: once only per person (§4.11 rule 2).
  originKey     String      @db.VarChar(160)
  createdAt     DateTime    @default(now())

  @@unique([userId, originKey])
  @@index([threadId, saidAt])
}

/// A question from the buddy that knows when it was answered (§4.4, §4.14).
/// Stage 8 (E5): a chat export he brought in (Claude, ChatGPT): his own messages only, read as old news, up to the
/// limit he approved after its estimate.
model BuddyImport {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// claude | chatgpt
  source      String    @db.VarChar(20)
  fileName    String?   @db.VarChar(200)
  /// His messages not heard before, in how many chats; those already known (another route, or an upload before).
  chats       Int       @default(0)
  messages    Int       @default(0)
  known       Int       @default(0)
  /// The estimate before anything is read, and the limit he approved.
  pieces      Int       @default(0)
  estimateUsd Decimal   @default(0) @db.Decimal(10, 4)
  limitUsd    Decimal?  @db.Decimal(10, 4)
  /// estimated | queued | cancelled
  state       String    @default("estimated") @db.VarChar(20)
  /// Pieces queued for the digest on his yes.
  queued      Int       @default(0)
  oldest      DateTime?
  newest      DateTime?
  /// Between the estimate and his yes: his messages (scrubbed), emptied once queued or cancelled.
  payload     Json      @default("[]")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, createdAt])
}

/// Stage 8 (§4.11 rule 3): an outside message the app has read, known by its chat, its words and its own time to
/// the second, so the same message by another route, or the same export twice, is read once.
model BuddyHeard {
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatKey     String   @db.VarChar(120)
  fingerprint String   @db.VarChar(64)
  saidAt      DateTime
  createdAt   DateTime @default(now())

  @@id([userId, chatKey, fingerprint, saidAt])
}

/// Stage 7 (§4.7): the buddy's own silent reminder for an active or committed thread: never a task, 2 a day at
/// most, never rings or emails; on the home picture with his reminders; he can take it back.
model BuddyReminder {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  threadId   String?
  thread     BuddyThread? @relation(fields: [threadId], references: [id], onDelete: Cascade)
  text       String       @db.VarChar(120)
  at         DateTime
  /// daily | weekdays | weekly, or none (the night sets none; kept for later).
  repeat     String?      @db.VarChar(20)
  /// The step that set it.
  buddyDayId String?
  /// pending | cancelled
  status     String       @default("pending") @db.VarChar(12)
  /// Stage 19: what it brings back (their Later on the home screen): tk (a task), th (an event thread), pu (a left-off
  /// session), rm (a reminder of theirs); its id; and why it exists (later), or none (the night's own).
  refKind    String?      @db.VarChar(10)
  refId      String?
  origin     String?      @db.VarChar(10)
  createdAt  DateTime     @default(now())

  @@index([userId, at])
}

/// Stage 7 (V1): his own words pinned to the lock screen for a window ("put this on my lock screen until 6"):
/// in its hours and days it is the lock line, over the buddy's words. Cleared by him or an agent on his word.
model LockPin {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String    @db.VarChar(120)
  /// Its hours, minutes of his day (from == to: all day; from > to crosses midnight).
  fromMin   Int
  toMin     Int
  /// The weekdays it shows (0 Sunday to 6 Saturday); empty: every day.
  days      Int[]     @default([])
  /// The last day it shows (his day), or none: until it is cleared.
  untilDay  DateTime? @db.Date
  /// you | agent | ask_ai
  setBy     String    @db.VarChar(20)
  agentName String?   @db.VarChar(60)
  clearedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, clearedAt])
}

model BuddyAsk {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  threadId     String?
  thread       BuddyThread? @relation(fields: [threadId], references: [id], onDelete: Cascade)
  /// ask | offer
  kind         String       @default("ask") @db.VarChar(10)
  text         String       @db.VarChar(200)
  /// Up to 3 quick answers: [{ label, meaning }] (meaning: done | skipped | yes | no | later).
  answers      Json         @default("[]")
  /// The thread's revision its writer saw (a new word about it withdraws the question).
  seenRevision Int?
  /// The step that wrote it.
  buddyDayId   String?
  fromAt       DateTime
  untilAt      DateTime
  /// open | replied | answered | passed | withdrawn | expired
  state        String       @default("open") @db.VarChar(12)
  /// Where it has shown: home | chat | brief | phone | lock
  shownOn      String[]     @default([])
  firstShownAt DateTime?
  answeredAt   DateTime?
  answer       String?      @db.VarChar(300)
  /// Stage 5: his thumb on the question itself ("less": it went quiet 14 days).
  thumb        String?      @db.VarChar(10)
  /// Stage 5b: why (private | time | useless | wrong), when he said.
  thumbReason  String?      @db.VarChar(12)
  /// Stage 6 (§4.14): the lock check passed its words, so the phone (app 0.6.0) may show it on the lock
  /// screen or in a notification's text there. False when it was not checked or the check failed.
  lockOk       Boolean      @default(false)
  createdAt    DateTime     @default(now())

  @@index([userId, state, untilAt])
}

/// Something the buddy does by itself after his standing yes (BUDDY_MEMORY_PLAN §3.6, B6): offered once
/// after he accepted the same kind of item three times in 30 days; each run is an agent edit with Undo.
model Routine {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// auto_task: the tasks he mentions with a day are added by themselves.
  kind       String    @db.VarChar(40)
  title      String    @db.VarChar(160)
  params     Json      @default("{}")
  enabled    Boolean   @default(true)
  runs       Int       @default(0)
  lastRunDay DateTime? @db.Date
  createdAt  DateTime  @default(now())

  @@unique([userId, kind])
}

/// A month (or a year) of his life in a short chapter (BUDDY_MEMORY_PLAN §3.7, B7): written on the 1st
/// from that month's numbers, notes and memory changes; kept for good, searched by recall_memory.
model BuddyChapter {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "2026-11"
  period    String   @db.VarChar(7)
  text      String
  /// The month's numbers it was written from (kept, so a number in the text can be traced).
  facts     Json     @default("{}")
  /// The audit's "Still true?" questions: [{ memoryId, question }], each answered once on /you.
  questions Json     @default("[]")
  model     String   @db.VarChar(100)
  costUsd   Decimal  @default(0) @db.Decimal(10, 6)
  createdAt DateTime @default(now())

  @@unique([userId, period])
}

// ─── The work log (BUDDY_MEMORY_PLAN §11.2, B9) ─────────────────────────────

enum WorkLineKind {
  did
  decided
  stuck
  next
}

/// B10: the summariser (his captured words, personal folders) or an agent on his word (log_work, office folders).
enum WorkLineSource {
  summary
  agent
}

/// What he did, per project and day (B9): a store apart from the memory about him. Dated lines that
/// never fade and never reach the portrait or the lock screen. The work summariser rewrites a
/// session's lines for its day; a line he removed stays as a row (`hidden`) so it isn't written again.
model WorkLine {
  id           String                   @id @default(cuid())
  userId       String
  user         User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// His local day of the piece's last message.
  day          DateTime                 @db.Date
  /// The folder key, lower case (as Project.key).
  project      String                   @db.VarChar(100)
  sessionKey   String                   @db.VarChar(80)
  kind         WorkLineKind
  /// Who wrote it (B10): the summariser from his captured words, or an agent he asked (log_work).
  source       WorkLineSource           @default(summary)
  /// The time it took, as the agent read it from the hook's clock ("10:15–11:40"); none from the summariser.
  at           String?                  @db.VarChar(20)
  text         String                   @db.VarChar(200)
  /// From a folder that never gets his brief: office work (only its own project's work brief shows it).
  office       Boolean                  @default(false)
  /// He removed it: never shown; the summariser is told not to write it again.
  hidden       Boolean                  @default(false)
  /// Its place in the session's list for the day.
  position     Int                      @default(0)
  /// Kept by a trigger from `text` (English stems and plain words); GIN index. Raw SQL only.
  searchVector Unsupported("tsvector")?
  createdAt    DateTime                 @default(now())
  /// ECOSYSTEM_V2_PLAN stage 12: when it happened (a web line: when it was logged; the summariser: its piece's last
  /// message; Claude Code's log_work: the end of its time span). A thing's newest state is its latest happenedAt, so a
  /// late older summary never becomes the newest. Null on older rows: read as createdAt.
  happenedAt   DateTime?
  /// Stage 12: the line this one is news on (an open problem now fixed, a decision changed): a thing is its chain.
  followsId    String?
  follows      WorkLine?                @relation("WorkFollows", fields: [followsId], references: [id], onDelete: SetNull)
  followers    WorkLine[]               @relation("WorkFollows")
  /// Stage 12: this line repeats that one (joined by the app that wrote it): kept, never shown or counted.
  sameAsId     String?
  sameAs       WorkLine?                @relation("WorkSameAs", fields: [sameAsId], references: [id], onDelete: SetNull)
  repeats      WorkLine[]               @relation("WorkSameAs")
  /// Stage 12: the app that wrote it ("ChatGPT", "Claude", "Claude Code"); stored, nothing reasons on it yet.
  app          String?                  @db.VarChar(60)

  @@index([userId, day])
  @@index([userId, project, day])
  @@index([userId, sessionKey, day])
  @@index([searchVector], type: Gin)
  @@index([followsId])
  @@index([sameAsId])
}

/// MCP_MEMORY_PLAN §4.7: a catch-up run, when the buddy's AI can run again after a long gap: the record is settled by
/// code, then what can be in motion is read oldest first, in batches, with its own dates. Never a question or a pulse.
model BuddyCatchUp {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Why it ran: 'ai_back' (credits, a cap reset, AI allowed) or 'switched_on' (the buddy or the loop).
  reason     String    @db.VarChar(20)
  /// The first and last day said of what it read.
  firstDay   DateTime? @db.Date
  lastDay    DateTime? @db.Date
  /// Notes settled, things read, batches queued.
  notes      Int       @default(0)
  things     Int       @default(0)
  batches    Int       @default(0)
  /// waiting | running | done | stopped
  state      String    @default("running") @db.VarChar(10)
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([userId, startedAt])
}

/// Stage 20 (ECOSYSTEM_V2_PLAN): what happened after the buddy's words showed, written by code for the day just ended,
/// before the night thinks. A quiet record: nothing reads it yet (scripts/what-landed.ts prints it for the talk after the
/// trial). One row per item a day.
model BuddyOutcome {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Their day it showed.
  day       DateTime  @db.Date
  /// line | thought | question | later
  shown     String    @db.VarChar(12)
  /// Its words (short).
  text      String    @db.VarChar(200)
  /// What it rested on: thread ids and refs (pu_…, tk_…).
  about     Json      @default("[]")
  /// Its hours.
  fromAt    DateTime?
  untilAt   DateTime?
  /// acted | answered | later | thumb_up | thumb_down | none
  outcome   String    @db.VarChar(12)
  /// Minutes from the start of its hours to what followed (none: null).
  minutes   Int?
  /// The item it records (the step and line, the question, the Later): written once.
  sourceKey String    @db.VarChar(120)
  createdAt DateTime  @default(now())

  @@unique([userId, sourceKey])
  @@index([userId, day])
}

/// Where you stand (WHERE_YOU_STAND_PLAN §9, the owner, 11-22): the buddy's take on a window (week, month, year), written
/// when the person asks for it on the page. One per day and window; it shows only on its day (the person's own date), and
/// the rows of earlier days are deleted at the next ask, so a take lasts a day and is gone.
model StandTake {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day       DateTime @db.Date
  window    String   @db.VarChar(8)
  text      String   @db.VarChar(1200)
  model     String   @db.VarChar(100)
  createdAt DateTime @default(now())

  @@unique([userId, day, window])
}

/// A deleted subject, kept for a week so it can be undone (the owner, 11-22: a subject can be deleted with everything
/// in it, with a week's undo). `payload` holds the rows that went (the subject, its topics, captures, revisions and
/// the rest, the tasks on its docs) and the rows that only lost their link (sessions, week targets, decisions); its
/// docs wait in the trash (`docIds`). After `expiresAt` the row and those docs are deleted for good.
model SubjectDeletion {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId String
  name      String
  payload   Json
  docIds    String[] @default([])
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId, createdAt])
  @@index([expiresAt])
}

/// TRUST_PLAN T4 (11-27): what the app showed the owner of a person (the People page, at most one row an hour) and what
/// the owner did to their account (a top-up, a daily limit, access ended or restored). The person reads their own rows
/// on Settings › Your data; the app never edits or deletes one (append-only), the night job prunes rows after a year,
/// and deleting the account deletes them (cascade).
model OwnerAccess {
  id      String          @id @default(cuid())
  userId  String
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind    OwnerAccessKind
  /// What the row is about: the facts shown (`shown`), an amount (`usd`), a daily limit (`limitUsd`).
  details Json?
  at      DateTime        @default(now())

  @@index([userId, at])
  @@index([at])
}

enum OwnerAccessKind {
  viewed
  topped_up
  limit_set
  access_ended
  access_restored
}
